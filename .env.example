# ──────────────────────────────────────────────────────────────
# Averix Labs — Environment Variables Template
# ──────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ──────────────────────────────────────────────────────────────

# ── Aiven PostgreSQL (server only) ─────────────────────────────
DATABASE_URL=postgres://avnadmin:YOUR_PASSWORD@YOUR_AIVEN_HOST:18710/defaultdb
# Download the CA certificate from Aiven → Overview → CA certificate.
DATABASE_CA_CERT_PATH=./certs/aiven-ca.pem
# Hosting environments can use DATABASE_CA_CERT with the PEM text instead.

# ── Analytics (optional) ──────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Site URL ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://averixlabs.in

# Google Search Console verification token (optional)
GOOGLE_SITE_VERIFICATION=

# GitHub Pages frontend only: public HTTPS backend endpoint (not a secret)
NEXT_PUBLIC_INQUIRY_API_URL=
# Backend only: comma-separated permitted website origins
INQUIRY_ALLOWED_ORIGINS=https://averixlabs.in
