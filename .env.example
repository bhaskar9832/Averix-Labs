# Copy to .env.local for local development. Never commit real credentials.
# For Render, Vercel or Netlify, add these values in the hosting dashboard.
# GitHub Actions secrets are not automatically copied to your hosting provider.

# Required on the backend: copy the actual Service URI from Aiven.
# The value below is an example, not a working database connection.
DATABASE_URL=postgres://avnadmin:AVNS_KBZDDdnYw2M3V8wFTpK@pg-caae141-souravsarkar257887-ba91.h.aivencloud.com:18710/defaultdb?sslmode=require

# Required for Aiven TLS verification: paste the complete CA certificate.
# In a local .env file, wrap multiline PEM text in double quotes.
# In a hosting dashboard, paste the PEM text directly, without wrapping quotes.
DATABASE_CA_CERT=

# Local alternative: download the CA file and uncomment this line.
# DATABASE_CA_CERT_PATH=./certs/aiven-ca.pem

# Primary public website domain. Set this before building.
NEXT_PUBLIC_SITE_URL=https://averixlabs.in

# Allowed website origins for the inquiry backend.
INQUIRY_ALLOWED_ORIGINS=https://averixlabs.in

# Optional Google Search Console verification code.
# GOOGLE_SITE_VERIFICATION=

# Only for a GitHub Pages frontend with a separately hosted backend.
# Leave unset when hosting the whole Next.js app on Render, Vercel or Netlify.
# NEXT_PUBLIC_INQUIRY_API_URL=https://YOUR_BACKEND_DOMAIN/api/inquiries

# Do not set BUILD_TARGET for a full Next.js deployment.
# The build:pages script sets it automatically for static export.
